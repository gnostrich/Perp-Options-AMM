NEXT_TELEMETRY_DISABLED=1

API_BASE_URL=https://backend.example
USERS_JSON="{"users":[{"username":"user1","password":"password1"},{"username":"user2","password":"password2"}]}"
ARBITRUM_RPC_URL="https://arb1.arbitrum.io/rpc"

DATABASE_ID='databaseID'
GOOGLE_SERVICE_KEY=servciekey

NEXT_PUBLIC_TEMPORAL_WALLET_LONG=walletgoeshere
NEXT_PUBLIC_TEMPORAL_WALLET_SHORT=walletgoeshere

# v2 paper-trading closed system (§13) — mirrors backend EXECUTION_MODE; default paper.
NEXT_PUBLIC_EXECUTION_MODE=paper

# v3 read-only book preview (additive, default off — CLAUDE.md v3 version hygiene).
# "true" shows a SOURCE v2|v3 toggle on the Order Book panel; v2 is byte-identical
# with this unset. Backend must also have V3_BOOK_ENABLED=true or the source 404s
# into the existing empty state.
NEXT_PUBLIC_V3_BOOK=false

USDC_ADDRESS=0xaf88d065e77c8cC2239327C5EDb3A432268e5831

# BFF Proxy — Extension API proxy settings
JWT_SECRET=super-secret-jwt-key-change-in-production
EXTENSION_ORIGIN=chrome-extension://your-extension-id-here